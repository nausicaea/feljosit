{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests",
    ":maintainLockFilesWeekly"
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Zurich",
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Group the development tools.",
      "matchDepTypes": ["dependency-groups"],
      "groupName": "development tools"
    },
    {
      "description": "Group the GitHub Actions.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Runtime dependencies: fix commits (they go into the release notes).",
      "matchDepTypes": ["project.dependencies"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    }
  ]
}
